# DevOps portal configuration.
# Copy to devops-portal/.env (docker compose) or devops-portal/backend/.env
# (uvicorn). On the AWS host this file is generated from SSM Parameter Store
# by infra/scripts/host-deploy.sh - see docs/architecture.md.

# ---------- Secrets ----------
# Fernet key encrypting AWS secret keys + SSH private keys in the database.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Left empty locally, one is generated next to the DB on first start.
PORTAL_ENCRYPTION_KEY=
# HS256 secret for login sessions (auto-generated locally when empty).
PORTAL_JWT_SECRET=
# Fernet key shared with GitHub Actions; must equal the PORTAL_WORKFLOW_KEY
# repository secret. Required when DEPLOYMENT_RUNNER_MODE=github_actions.
PORTAL_WORKFLOW_KEY=

# ---------- App ----------
CORS_ORIGINS=http://localhost:5173
DB_PATH=deployments.db
# true | false | first (only until the first account exists)
PORTAL_ALLOW_SIGNUP=true
# Set to true when the portal is served over HTTPS.
PORTAL_COOKIE_SECURE=false
PORTAL_SESSION_HOURS=12
# Background EC2 state sync (seconds, 0 disables).
RECONCILE_INTERVAL_SECONDS=120
AWS_DEFAULT_REGION=ap-south-1

# ---------- Where deployments run ----------
# local          - Terraform + Ansible inside the backend
# github_actions - dispatch .github/workflows/portal-deploy.yml
DEPLOYMENT_RUNNER_MODE=local

# GitHub Actions integration (DEPLOYMENT_RUNNER_MODE=github_actions).
# Fine-grained token on the repo: Actions read & write, Contents read.
GITHUB_REPO=ECD2026/control_tower
GITHUB_TOKEN=replace_me
GITHUB_WORKFLOW=portal-deploy.yml
GITHUB_REF_NAME=main
GITHUB_POLL_INTERVAL_SECONDS=5
GITHUB_REQUEST_TIMEOUT_SECONDS=30

# ---------- Ansible ----------
ANSIBLE_HOST_KEY_CHECKING=False
# Fallback key location for instances created before credentials existed.
SSH_KEY_DIR=~/.ssh

# ---------- Monitoring ----------
# Relative URL: Grafana is proxied on the same origin at /grafana.
GRAFANA_PUBLIC_URL=/grafana
GRAFANA_DASHBOARD_UID=instance-overview
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_URL=http://localhost:9090/prometheus
PROMETHEUS_TARGETS_PATH=../monitoring/prometheus/targets/instances.json
# public (portal outside AWS) | private (portal on EC2 in the same VPC)
PROMETHEUS_SCRAPE_ADDRESS=public
# Portal host SG allowed to scrape node_exporter (9100) on deployed instances.
PORTAL_MONITORING_SG_ID=
PORTAL_MONITORING_SG_REGION=
# CloudWatch exporter (python -m exporters.cloudwatch_exporter)
CLOUDWATCH_EXPORTER_PORT=9106
CLOUDWATCH_REFRESH_SECONDS=60
